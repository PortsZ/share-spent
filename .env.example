# Required in production — src/lib/env.ts throws at startup if any are missing.
# Set all of these in Vercel (Project → Settings → Environment Variables).

# Postgres. Use a pooled connection string on serverless (e.g. Neon/Supabase pooler).
DATABASE_URL="postgresql://user:password@host:5432/sharespent"

# Clerk — dashboard.clerk.com → API keys
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# OpenAI — used by the receipt parsing pipeline
OPENAI_API_KEY="sk-..."

# S3 bucket for receipt images
AWS_S3_BUCKET="sharespent-receipts"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
